GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/para/service-account.json
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# Conta raiz do site (obrigatórios). Outros usuários são criados em /register e ficam
# no SQLite server/users.db.
APP_USERNAME=usuario
APP_PASSWORD=troque-esta-senha
# Segredo usado para assinar o token de sessão. Se ficar vazio, um segredo temporário é
# gerado a cada start e todas as sessões caem quando o servidor reinicia.
# Gere um com: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Validade do token de sessão, em horas (padrão 12).
AUTH_TOKEN_TTL_HOURS=12
# Segredo pedido na tela /register para autorizar a criação de conta. Vazio = usa o
# AUTH_SECRET (que é o que a tela sugere digitar); preencha para desacoplar os dois.
REGISTRATION_SECRET=
